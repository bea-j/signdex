{
  "manifest_version": 3,
  "name": "SignSeek",
  "version": "0.0.1",
  "description": "Look up ASL signs you see in videos. Runs on your device.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open SignSeek"
  },
  "commands": {
    "lookup-sign": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Look up a sign from the last few seconds of video"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
