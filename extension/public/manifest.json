{
  "manifest_version": 3,
  "name": "Signdex",
  "version": "0.1.0",
  "description": "Look up ASL signs you see in videos. Runs on your device.",
  "minimum_chrome_version": "116",
  "permissions": ["sidePanel", "storage", "tabCapture", "offscreen", "scripting", "activeTab"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Signdex"
  },
  "commands": {
    "lookup-sign": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Look up a sign from the last few seconds of video"
    }
  },
  "web_accessible_resources": [
    { "resources": ["capture-frame.html"], "matches": ["<all_urls>"] }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
