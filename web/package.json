{
  "name": "@signseek/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "fetch-mediapipe": "node scripts/fetch-mediapipe.mjs",
    "predev": "node scripts/fetch-mediapipe.mjs && node scripts/copy-model.mjs",
    "dev": "vite",
    "prebuild": "node scripts/fetch-mediapipe.mjs && node scripts/copy-model.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "test:parity": "vitest run test/parity.test.ts",
    "dictionary": "node scripts/build-dictionary.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "onnxruntime-web": "^1.31.1"
  }
}
